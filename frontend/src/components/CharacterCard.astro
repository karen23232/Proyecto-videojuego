---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  imageSrc: ImageMetadata;
  imageStyle?: string;
  description: string;
  stats: { label: string; value: number }[];
}

const { name, role, imageSrc, imageStyle = '', description, stats } = Astro.props;
---

<div class="char-card">
  <div class="char-card-inner">
    <div class="char-front">
      <Image src={imageSrc} alt={name} style={imageStyle} />
      <div class="flip-hint">⟳</div>
      <div class="char-front-info">
        <div class="char-name">{name}</div>
        <div class="char-role">{role}</div>
      </div>
    </div>
    <div class="char-back">
      <div class="char-back-name">{name}</div>
      <div class="char-back-role">{role}</div>
      <p class="char-back-desc">{description}</p>
      <div class="char-stats">
        {stats.map((stat) => (
          <div class="char-stat">
            <div class="char-stat-label">
              <span>{stat.label}</span>
              <span>{stat.value}</span>
            </div>
            <div class="stat-bar">
              <div class="stat-fill" style={`width: ${stat.value}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .char-card {
    position: relative;
    height: 620px;
    cursor: pointer;
    perspective: 1400px;
  }

  .char-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.85s cubic-bezier(0.4, 0.2, 0.2, 1);
    transform-style: preserve-3d;
  }

  .char-card:hover .char-card-inner {
    transform: rotateY(180deg);
  }

  .char-front, .char-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
  }

  .char-front {
    background: var(--violet);
    border: 1px solid rgba(220,214,196,0.08);
  }

  .char-front :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .char-front:hover :global(img) {
    transform: scale(1.03);
  }

  .char-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(7,7,7,0.9) 100%);
  }

  .char-front-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    z-index: 2;
  }

  .char-name {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--beige);
    margin-bottom: 4px;
  }

  .char-role {
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--red);
    font-family: var(--font-display);
  }

  .flip-hint {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 3;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(220,214,196,0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    animation: spin 8s linear infinite;
    background: rgba(7,7,7,0.4);
    color: var(--beige-dim);
  }

  .char-back {
    transform: rotateY(180deg);
    background: linear-gradient(135deg, var(--violet) 0%, #1a0840 50%, var(--blue) 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 44px 40px;
    border: 1px solid rgba(102,18,20,0.5);
    position: relative;
    overflow: hidden;
  }

  .char-back::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(102,18,20,0.35) 0%, transparent 70%);
    border-radius: 50%;
  }

  .char-back::after {
    content: '';
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(24,51,72,0.4) 0%, transparent 70%);
    border-radius: 50%;
  }

  .char-back-name {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 900;
    color: var(--beige);
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
  }

  .char-back-role {
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--red);
    font-family: var(--font-display);
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(220,214,196,0.12);
    position: relative;
    z-index: 1;
  }

  .char-back-desc {
    font-size: 15px;
    line-height: 1.9;
    color: var(--beige-dim);
    margin-bottom: 28px;
    font-weight: 300;
    position: relative;
    z-index: 1;
  }

  .char-stats {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    z-index: 1;
  }

  .char-stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .char-stat-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: var(--font-display);
  }

  .char-stat-label span:first-child {
    color: var(--beige-dim);
  }

  .char-stat-label span:last-child {
    color: var(--yellow);
  }

  .stat-bar {
    height: 3px;
    background: rgba(220,214,196,0.1);
    position: relative;
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--red), var(--yellow));
    box-shadow: 0 0 10px rgba(217,211,39,0.4);
  }

  @media (max-width: 768px) {
    .char-card {
      height: 500px;
    }
  }
</style>
