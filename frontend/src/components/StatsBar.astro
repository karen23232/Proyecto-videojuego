<div class="stats-bar">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-number"><span class="accent" id="cnt1">150</span>K+</span>
        <span class="stat-label">Jugadores Registrados</span>
      </div>
      <div class="stat-item">
        <span class="stat-number"><span class="accent" id="cnt2">48</span></span>
        <span class="stat-label">Horas de Historia</span>
      </div>
      <div class="stat-item">
        <span class="stat-number"><span class="accent" id="cnt3">24</span>+</span>
        <span class="stat-label">Finales Únicos</span>
      </div>
      <div class="stat-item">
        <span class="stat-number"><span class="accent" id="cnt4">4.8</span><span class="star">★</span></span>
        <span class="stat-label">Calificación Media</span>
      </div>
    </div>
  </div>
</div>

<style>
  .stats-bar {
    background: linear-gradient(135deg, var(--violet), #1a0840);
    border-top: 1px solid rgba(220,214,196,0.05);
    border-bottom: 1px solid rgba(220,214,196,0.05);
    padding: 36px 0;
  }

  @media (min-width: 768px) { .stats-bar { padding: 48px 0; } }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat-item {
    text-align: center;
    padding: 20px 16px;
    position: relative;
  }

  @media (min-width: 768px) { .stat-item { padding: 24px; } }

  /* Vertical separators - desktop */
  @media (min-width: 768px) {
    .stat-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      height: 60%;
      width: 1px;
      background: rgba(220,214,196,0.1);
    }
  }

  /* Horizontal separators - mobile 2x2 grid */
  @media (max-width: 767px) {
    .stat-item:nth-child(1),
    .stat-item:nth-child(2) {
      border-bottom: 1px solid rgba(220,214,196,0.08);
    }
    .stat-item:nth-child(odd) {
      border-right: 1px solid rgba(220,214,196,0.08);
    }
  }

  .stat-number {
    font-family: var(--font-tech);
    font-size: clamp(28px, 6vw, 40px);
    font-weight: 900;
    color: var(--beige);
    display: block;
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-number .accent { color: var(--yellow); }

  .star {
    color: var(--yellow);
    font-size: clamp(18px, 4vw, 28px);
  }

  .stat-label {
    font-size: clamp(9px, 2vw, 11px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--beige-dim);
    font-family: var(--font-display);
  }
</style>
