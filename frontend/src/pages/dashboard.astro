---
import '../styles/global.css';
import Dashboard from '../components/Dashboard';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Archivo Mental — Recessed Minds</title>
    <link rel="icon" type="image/png" href="/images/Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@700&family=Rajdhani:wght@300;400;500;600&family=Orbitron:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { background: #070707; overflow-x: hidden; }
    </style>
  </head>
  <body>
    <Dashboard client:load />
  </body>
</html>

<style is:global>
  /* ── Loading ── */
  .db-loading {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--black);
  }
  .db-loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .db-loading-bar {
    width: 160px;
    height: 2px;
    background: rgba(220,214,196,0.08);
    position: relative;
    overflow: hidden;
  }
  .db-loading-bar::after {
    content: '';
    position: absolute;
    top: 0; left: -60%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--red), transparent);
    animation: loadSlide 1.2s ease-in-out infinite;
  }
  @keyframes loadSlide {
    to { left: 100%; }
  }
  .db-loading-text {
    font-family: var(--font-tech);
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--beige-dim);
    animation: blink 1.5s ease-in-out infinite;
  }

  /* ── Root ── */
  .db-root {
    min-height: 100svh;
    background: var(--black);
    color: var(--beige);
    font-family: var(--font-body);
    position: relative;
    overflow-x: hidden;
  }

  /* ── Scanlines overlay ── */
  .db-scanlines {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 2px,
      rgba(0,0,0,0.1) 2px,
      rgba(0,0,0,0.1) 4px
    );
    pointer-events: none;
    z-index: 200;
  }

  /* ── Nav ── */
  .db-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    height: 60px;
    background: rgba(7,7,7,0.97);
    border-bottom: 1px solid rgba(102,18,20,0.35);
    backdrop-filter: blur(10px);
  }
  @media (min-width: 768px) { .db-nav { padding: 0 32px; gap: 16px; } }

  .db-nav-brand { display: flex; align-items: center; flex-shrink: 0; }
  .db-nav-logo { height: 30px; }
  @media (min-width: 480px) { .db-nav-logo { height: 34px; } }

  .db-nav-title {
    font-family: var(--font-tech);
    font-size: clamp(9px, 1.8vw, 13px);
    letter-spacing: 4px;
    color: var(--red-bright);
    flex: 1;
    text-align: center;
    display: none;
    position: relative;
    animation: titleGlitch 7s infinite;
  }
  @media (min-width: 500px) { .db-nav-title { display: block; } }

  @keyframes titleGlitch {
    0%, 90%, 100% { text-shadow: none; }
    91% { text-shadow: -2px 0 rgba(102,18,20,0.9), 2px 0 rgba(24,51,72,0.9); letter-spacing: 4.5px; }
    92% { text-shadow: 2px 0 rgba(46,16,101,0.8), -2px 0 rgba(217,211,39,0.7); letter-spacing: 3.5px; }
    93% { text-shadow: none; letter-spacing: 4px; }
    96% { text-shadow: -1px 0 rgba(102,18,20,0.6), 1px 0 rgba(24,51,72,0.6); }
    97% { text-shadow: none; }
  }

  .db-nav-user {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .db-nav-userinfo {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  @media (min-width: 640px) { .db-nav-userinfo { display: flex; } }

  .db-nav-username {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--beige);
  }
  .db-nav-status {
    font-family: var(--font-tech);
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--green);
  }
  .db-logout-btn {
    background: none;
    border: 1px solid rgba(102,18,20,0.5);
    color: var(--beige-dim);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 14px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }
  .db-logout-btn:hover {
    border-color: var(--red);
    color: var(--beige);
    box-shadow: 0 0 16px rgba(102,18,20,0.3);
  }

  /* ── Content wrapper ── */
  .db-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px 20px 88px;
  }
  @media (min-width: 768px) { .db-content { padding: 24px 32px 88px; } }
  @media (min-width: 1024px) { .db-content { padding: 28px 48px 88px; } }

  /* ── Greeting ── */
  .db-greeting {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(220,214,196,0.06);
  }
  .db-greeting-label {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--red-bright);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .db-greeting-label::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--red);
    flex-shrink: 0;
  }
  .db-greeting-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 5vw, 42px);
    font-weight: 700;
    color: var(--beige);
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .db-greeting-name { color: var(--red-bright); }
  .db-greeting-sub {
    font-size: 13px;
    color: var(--beige-dim);
    letter-spacing: 0.5px;
  }

  /* ── Stats grid ── */
  .db-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 40px;
  }
  @media (min-width: 640px) {
    .db-stats-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; }
  }

  .db-stat-card {
    background: rgba(14,4,32,0.6);
    border: 1px solid rgba(220,214,196,0.07);
    border-left: 3px solid var(--stat-accent, var(--red));
    padding: 18px 16px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s, transform 0.3s;
  }
  .db-stat-card::after {
    content: '';
    position: absolute;
    bottom: 0; right: 0;
    width: 40px;
    height: 40px;
    background: radial-gradient(circle at bottom right, var(--stat-accent, var(--red)), transparent 70%);
    opacity: 0.07;
    pointer-events: none;
  }
  @media (hover: hover) {
    .db-stat-card:hover { background: rgba(46,16,101,0.2); transform: translateY(-2px); }
  }
  .db-stat-value {
    font-family: var(--font-tech);
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 600;
    color: var(--beige);
    line-height: 1;
    margin-bottom: 8px;
  }
  .db-stat-label {
    font-family: var(--font-display);
    font-size: 8px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--beige-dim);
  }

  /* ── Main layout ── */
  .db-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .db-layout { grid-template-columns: 1fr 300px; }
  }
  @media (min-width: 1100px) {
    .db-layout { grid-template-columns: 1fr 340px; }
  }

  /* ── Section title ── */
  .db-section-title {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--beige);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(102,18,20,0.4);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .db-section-title::before {
    content: '';
    width: 20px;
    height: 2px;
    background: var(--red);
    flex-shrink: 0;
  }

  /* ── Comment cards ── */
  .db-comment-card {
    background: rgba(14,4,32,0.5);
    border: 1px solid rgba(220,214,196,0.07);
    border-left: 3px solid rgba(220,214,196,0.12);
    padding: 18px 20px;
    margin-bottom: 12px;
    transition: background 0.3s;
  }
  @media (hover: hover) {
    .db-comment-card:hover { background: rgba(46,16,101,0.15); }
  }
  .db-comment-card.rating-5 { border-left-color: var(--green); }
  .db-comment-card.rating-4 { border-left-color: var(--yellow); }
  .db-comment-card.rating-3,
  .db-comment-card.rating-2,
  .db-comment-card.rating-1 { border-left-color: var(--red); }

  .db-comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .db-stars { display: flex; gap: 3px; }
  .db-star { line-height: 1; }
  .db-star.filled { color: var(--yellow); }
  .db-star.empty { color: rgba(220,214,196,0.2); }

  .db-comment-date {
    font-family: var(--font-tech);
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--beige-dim);
    opacity: 0.55;
  }
  .db-comment-text {
    font-size: 14px;
    line-height: 1.75;
    color: var(--beige-dim);
    margin-bottom: 14px;
    font-weight: 300;
  }
  .db-comment-actions { display: flex; gap: 8px; }

  .db-action-btn {
    background: none;
    border: 1px solid rgba(220,214,196,0.15);
    color: var(--beige-dim);
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 12px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .db-action-btn:hover { border-color: var(--beige-dim); color: var(--beige); }
  .db-action-btn--danger {
    border-color: rgba(102,18,20,0.3);
    color: rgba(139,26,29,0.8);
  }
  .db-action-btn--danger:hover {
    border-color: var(--red);
    color: var(--red-bright);
    background: rgba(102,18,20,0.1);
  }

  .db-edit-textarea {
    width: 100%;
    background: rgba(46,16,101,0.2);
    border: 1px solid rgba(220,214,196,0.15);
    color: var(--beige);
    padding: 10px 12px;
    font-family: var(--font-body);
    font-size: 14px;
    min-height: 88px;
    resize: vertical;
    outline: none;
    margin-bottom: 12px;
    transition: border-color 0.3s;
  }
  .db-edit-textarea:focus { border-color: rgba(102,18,20,0.6); }

  /* ── Empty state ── */
  .db-empty {
    text-align: center;
    padding: 48px 24px;
    color: var(--beige-dim);
    font-size: 14px;
    background: rgba(14,4,32,0.3);
    border: 1px dashed rgba(220,214,196,0.08);
  }
  .db-empty-link {
    display: inline-block;
    margin-top: 14px;
    color: var(--red-bright);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 2px;
    text-decoration: underline;
    text-transform: uppercase;
  }

  /* ── Side panel ── */
  .db-side-panel { display: flex; flex-direction: column; gap: 24px; }

  .db-panel-block {
    background: rgba(14,4,32,0.5);
    border: 1px solid rgba(220,214,196,0.07);
    border-top: 2px solid rgba(102,18,20,0.5);
    padding: 20px;
  }
  .db-lore-text {
    font-size: 13px;
    line-height: 1.85;
    color: var(--beige-dim);
    font-style: italic;
    margin-bottom: 10px;
    font-weight: 300;
  }
  .db-lore-sub {
    font-family: var(--font-tech);
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(160,154,140,0.45);
  }

  .db-activity-list { display: flex; flex-direction: column; gap: 14px; }
  .db-activity-item {
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(220,214,196,0.05);
  }
  .db-activity-item:last-child { border-bottom: none; padding-bottom: 0; }
  .db-activity-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .db-activity-date {
    font-family: var(--font-tech);
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--beige-dim);
    opacity: 0.5;
  }
  .db-activity-excerpt {
    font-size: 12px;
    line-height: 1.6;
    color: var(--beige-dim);
    font-weight: 300;
  }
  .db-activity-empty {
    font-size: 13px;
    color: var(--beige-dim);
    opacity: 0.5;
    font-style: italic;
  }

  /* ── Bottom bar ── */
  .db-bottom-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(7,7,7,0.97);
    border-top: 1px solid rgba(220,214,196,0.07);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  @media (min-width: 768px) { .db-bottom-bar { padding: 10px 48px; } }

  .db-sanity-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .db-sanity-label {
    font-family: var(--font-tech);
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--beige-dim);
    white-space: nowrap;
    flex-shrink: 0;
    display: none;
  }
  @media (min-width: 480px) { .db-sanity-label { display: block; } }

  .db-sanity-track {
    width: 120px;
    height: 3px;
    background: rgba(220,214,196,0.07);
    flex-shrink: 0;
  }
  @media (min-width: 640px) { .db-sanity-track { width: 180px; } }

  .db-sanity-fill {
    height: 100%;
    width: 72%;
    background: var(--green);
    animation: sanityFlicker 3.5s ease-in-out infinite;
    box-shadow: 0 0 6px var(--green);
  }
  @keyframes sanityFlicker {
    0%, 100% { width: 72%; opacity: 1; }
    20%       { width: 75%; }
    45%       { width: 70%; opacity: 0.85; }
    60%       { width: 73%; opacity: 1; }
    80%       { width: 71%; opacity: 0.9; }
    88%       { width: 74%; opacity: 0.7; }
    90%       { width: 72%; opacity: 1; }
  }

  .db-back-link {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--beige-dim);
    white-space: nowrap;
    transition: color 0.2s;
    flex-shrink: 0;
  }
  .db-back-link:hover { color: var(--beige); }
</style>
