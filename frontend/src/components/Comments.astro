---
import CommentsWidget from './CommentsWidget.jsx';
---

<section class="comments-section" id="comunidad">
  <div class="container">
    <CommentsWidget client:visible />
  </div>
</section>

<style>
  .comments-section {
    background:
      linear-gradient(180deg, var(--black) 0%, rgba(46,16,101,0.08) 50%, var(--black) 100%);
  }
</style>

<style is:global>
  /* ── Header ── */
  .comments-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 48px;
  }

  @media (min-width: 768px) {
    .comments-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .comments-rating-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  @media (min-width: 768px) {
    .comments-rating-badge { align-items: flex-end; }
  }

  .comments-rating-stars {
    color: var(--yellow);
    font-size: 20px;
    letter-spacing: 3px;
    line-height: 1;
  }

  .comments-rating-number {
    font-family: var(--font-tech);
    font-size: 32px;
    font-weight: 900;
    color: var(--beige);
    line-height: 1;
  }

  .comments-rating-label {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--beige-dim);
  }

  /* ── Grid ── */
  .comments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }

  @media (min-width: 640px) {
    .comments-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }

  @media (min-width: 1024px) {
    .comments-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }

  /* ── Comment card ── */
  .comment-card {
    background: rgba(14, 4, 32, 0.6);
    border: 1px solid rgba(220,214,196,0.07);
    border-left: 3px solid rgba(220,214,196,0.15);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    position: relative;
    overflow: hidden;
  }

  .comment-card::after {
    content: '"';
    position: absolute;
    bottom: -20px;
    right: 16px;
    font-family: 'Cinzel Decorative', serif;
    font-size: 100px;
    line-height: 1;
    color: rgba(220,214,196,0.04);
    pointer-events: none;
    user-select: none;
  }

  .comment-card:hover {
    background: rgba(46,16,101,0.2);
    transform: translateY(-3px);
  }

  .comment-card.rating-5 { border-left-color: var(--green); }
  .comment-card.rating-4 { border-left-color: var(--yellow); }
  .comment-card.rating-3,
  .comment-card.rating-2,
  .comment-card.rating-1 { border-left-color: var(--red); }

  .comment-card.rating-5:hover { border-color: rgba(58,188,32,0.4); border-left-color: var(--green); }
  .comment-card.rating-4:hover { border-color: rgba(217,211,39,0.3); border-left-color: var(--yellow); }

  /* ── Stars ── */
  .comment-stars {
    display: flex;
    gap: 3px;
  }

  .comment-star {
    font-size: 15px;
    line-height: 1;
  }

  .comment-star.filled { color: var(--yellow); }
  .comment-star.empty  { color: rgba(220,214,196,0.2); }

  /* ── Text ── */
  .comment-text {
    font-size: 14px;
    line-height: 1.85;
    color: var(--beige-dim);
    font-weight: 300;
    flex: 1;
  }

  /* ── Edit input ── */
  .comment-edit-input {
    width: 100%;
    background: rgba(46,16,101,0.25);
    border: 1px solid rgba(220,214,196,0.15);
    color: var(--beige);
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 14px;
    min-height: 96px;
    resize: vertical;
    outline: none;
    flex: 1;
    transition: border-color 0.3s;
  }

  .comment-edit-input:focus {
    border-color: var(--red);
  }

  /* ── Author ── */
  .comment-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgba(220,214,196,0.06);
  }

  .comment-author {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .comment-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--violet-mid), var(--red));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--beige);
    flex-shrink: 0;
    border: 1px solid rgba(220,214,196,0.1);
  }

  .comment-author-name {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--beige);
  }

  .comment-author-date {
    font-size: 11px;
    color: var(--beige-dim);
    opacity: 0.55;
    margin-top: 2px;
  }

  /* ── Actions ── */
  .comment-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .comment-btn {
    background: none;
    border: 1px solid rgba(220,214,196,0.15);
    color: var(--beige-dim);
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .comment-btn:hover {
    border-color: var(--beige-dim);
    color: var(--beige);
  }

  .comment-btn.danger {
    border-color: rgba(102,18,20,0.3);
    color: rgba(139,26,29,0.8);
  }

  .comment-btn.danger:hover {
    border-color: var(--red);
    color: var(--red-bright);
    background: rgba(102,18,20,0.1);
  }

  /* ── Load more ── */
  .comments-load-more {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* ── Loading skeleton ── */
  .comments-loading {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }

  @media (min-width: 640px) { .comments-loading { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .comments-loading { grid-template-columns: repeat(3, 1fr); } }

  .skeleton-card {
    background: rgba(14,4,32,0.5);
    border: 1px solid rgba(220,214,196,0.05);
    border-left: 3px solid rgba(220,214,196,0.08);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .skeleton-line {
    background: rgba(220,214,196,0.06);
    border-radius: 2px;
    animation: shimmer 1.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* ── Form ── */
  .comment-form {
    background: rgba(7,7,7,0.7);
    border: 1px solid rgba(220,214,196,0.08);
    padding: 28px 24px;
    position: relative;
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .comment-form { padding: 40px 36px; }
  }

  .comment-form::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--red) 0%, var(--violet) 50%, var(--blue) 100%);
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--beige);
    margin-bottom: 24px;
  }

  @media (min-width: 768px) {
    .form-title { font-size: 16px; margin-bottom: 32px; }
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  @media (min-width: 560px) {
    .form-grid { grid-template-columns: 1fr 1fr; }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label,
  .form-group .form-label {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--beige-dim);
    font-family: var(--font-display);
  }

  .form-group input,
  .form-group textarea {
    background: rgba(46,16,101,0.18);
    border: 1px solid rgba(220,214,196,0.1);
    color: var(--beige);
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 15px;
    outline: none;
    transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
    resize: none;
    width: 100%;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(160,154,140,0.4);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: rgba(102,18,20,0.6);
    background: rgba(102,18,20,0.08);
    box-shadow: 0 0 0 3px rgba(102,18,20,0.1);
  }

  .form-group textarea {
    height: 110px;
    margin-bottom: 4px;
  }

  /* ── Star rating (form) ── */
  .star-rating {
    display: flex;
    gap: 6px;
    padding-top: 4px;
  }

  .star-btn {
    background: transparent;
    border: none;
    color: rgba(220,214,196,0.2);
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: color 0.15s, transform 0.15s;
  }

  .star-btn:hover,
  .star-btn.active {
    color: var(--yellow);
  }

  .star-btn:hover {
    transform: scale(1.15);
  }

  /* ── Submit button ── */
  .form-submit {
    width: 100%;
    padding: 14px;
    background: var(--red);
    color: var(--beige);
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: background 0.3s, box-shadow 0.3s;
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .form-submit { width: auto; padding: 14px 40px; }
  }

  .form-submit:hover:not(:disabled) {
    background: var(--red-bright);
    box-shadow: 0 0 30px rgba(102,18,20,0.5);
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Auth prompt ── */
  .auth-prompt {
    text-align: center;
    padding: 20px;
    color: var(--beige-dim);
    font-size: 14px;
  }

  .auth-prompt a, .auth-prompt button {
    color: var(--red);
    cursor: pointer;
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 14px;
    text-decoration: underline;
  }
</style>
