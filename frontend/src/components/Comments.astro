---
import CommentsWidget from './CommentsWidget.jsx';
---

<section class="comments-section" id="comunidad">
  <div class="container">
    <CommentsWidget client:visible />
  </div>
</section>

<style>
  .comments-section {
    background: linear-gradient(180deg, var(--black) 0%, rgba(46,16,101,0.1) 50%, var(--black) 100%);
  }

  .comments-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .comments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  .comment-card {
    background: rgba(46,16,101,0.15);
    border: 1px solid rgba(220,214,196,0.08);
    padding: 28px;
    position: relative;
    transition: all 0.3s;
  }

  .comment-actions {
    margin-top: 12px;
    display: flex;
    gap: 8px;
  }

  .comment-edit-input {
    width: 100%;
    background: rgba(46,16,101,0.2);
    border: 1px solid rgba(220,214,196,0.12);
    color: var(--beige);
    padding: 12px;
    font-family: var(--font-body);
    font-size: 14px;
    min-height: 96px;
    resize: vertical;
    margin-bottom: 16px;
  }

  .comment-card:hover {
    border-color: rgba(102,18,20,0.4);
    background: rgba(46,16,101,0.25);
    transform: translateY(-4px);
  }

  .comment-card::before {
    content: '"';
    position: absolute;
    top: 16px;
    right: 20px;
    font-family: 'Cinzel Decorative', serif;
    font-size: 60px;
    color: rgba(102,18,20,0.3);
    line-height: 1;
  }

  .comment-stars {
    color: var(--yellow);
    font-size: 14px;
    margin-bottom: 12px;
    letter-spacing: 2px;
  }

  .comment-text {
    font-size: 14px;
    line-height: 1.8;
    color: var(--beige-dim);
    margin-bottom: 20px;
    font-weight: 300;
  }

  .comment-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .comment-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--violet), var(--red));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--beige);
    flex-shrink: 0;
  }

  .comment-author-info .name {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--beige);
    font-weight: 600;
  }

  .comment-author-info .date {
    font-size: 11px;
    color: var(--beige-dim);
    opacity: 0.6;
  }

  .comment-form {
    background: rgba(7,7,7,0.6);
    border: 1px solid rgba(220,214,196,0.1);
    padding: 40px;
    position: relative;
  }

  .comment-form::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--red), var(--violet), var(--blue));
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--beige);
    margin-bottom: 28px;
    letter-spacing: 2px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label,
  .form-group .form-label {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--beige-dim);
    font-family: var(--font-display);
  }

  .form-group input,
  .form-group textarea {
    background: rgba(46,16,101,0.2);
    border: 1px solid rgba(220,214,196,0.12);
    color: var(--beige);
    padding: 14px 18px;
    font-family: var(--font-body);
    font-size: 15px;
    outline: none;
    transition: all 0.3s;
    resize: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--red);
    background: rgba(102,18,20,0.1);
    box-shadow: 0 0 20px rgba(102,18,20,0.2);
  }

  .form-group textarea {
    height: 120px;
  }

  @media (max-width: 768px) {
    .comments-grid {
      grid-template-columns: 1fr;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .comments-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

<style is:global>
