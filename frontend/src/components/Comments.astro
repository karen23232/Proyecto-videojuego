  }

  .comments-section .star-btn {
    background: transparent;
    border: none;
    color: rgba(220,214,196,0.4);
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .comments-section .star-btn.active {
    color: var(--yellow);
  }

  .comments-section .comments-load-more {
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }

  @media (max-width: 768px) {
    .comments-section .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
